# ==============================================================================
# FinPlot AI — Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit the '.env' file to Git or share it publicly.

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (NEVER expose to client code, used only for backend admin migrations if needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Environment: development | production
APP_ENV=development

# Future Phase Configurations (Leave commented or empty in Phase 1)
# GEMINI_API_KEY=your-gemini-api-key-here
